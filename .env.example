# Required for AI scoring and generation
LLM_API_KEY=your_llm_api_key_here
MODEL=google/gemini-3-flash-preview

# Required for PDF generation with RxResume
RXRESUME_EMAIL=your_email@example.com
RXRESUME_PASSWORD=your_password_here

# Optional: use self-hosted RxResume instead of public service
# RXRESUME_URL=https://your-rxresume.example.com

# Optional: public URL used for links in background pipeline tasks
# JOBOPS_PUBLIC_BASE_URL=https://your-jobops-domain.up.railway.app

# Optional: lock write operations behind basic auth
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASSWORD=change_me

# Optional: Gmail tracking integration
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REDIRECT_URI=https://your-jobops-domain.up.railway.app/oauth/gmail/callback

# Optional: extractor providers
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# UKVISAJOBS_EMAIL=
# UKVISAJOBS_PASSWORD=
# UKVISAJOBS_HEADLESS=true

# Runtime toggles
PORT=3001
RUN_MIGRATIONS=true
