# Nothing here is required to boot: Job Ops walks you through setup in the UI
# on first launch. Set what you want pre-filled.

# LLM used for scoring and CV generation. Providers: atlascloud, openrouter,
# orcarouter, requesty, openai, gemini, gemini_cli, claude_cli, codex. The CLI
# providers are bundled in the image and log in from the UI.
# LLM_PROVIDER=openrouter
# LLM_API_KEY=
# MODEL=google/gemini-3-flash-preview

# Reactive Resume v5 API key, for tailored CVs rendered by rxresu.me. Leave
# RXRESUME_URL unset to use the hosted service.
# RXRESUME_API_KEY=
# RXRESUME_URL=https://rxresu.me

# Public URL used in links generated by background jobs. The IaC file sets it
# from Railway's public domain.
# JOBOPS_PUBLIC_BASE_URL=https://your-jobops-domain.up.railway.app

# Put the app and API behind HTTP basic auth. Unset, the app is open.
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASSWORD=change_me

# Gmail tracking integration.
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REDIRECT_URI=https://your-jobops-domain.up.railway.app/oauth/gmail/callback

# Extractor providers.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# APIFY_TOKEN=
# UKVISAJOBS_EMAIL=
# UKVISAJOBS_PASSWORD=

# Runtime. Pinned by the IaC file; PORT must match the domain's target port,
# DATA_DIR must be the volume's mount path.
# PORT=3001
# DATA_DIR=/app/data
# CODEX_HOME=/app/data/codex-home
# XDG_CACHE_HOME=/app/data/cache
